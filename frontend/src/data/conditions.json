          "missedDays": 2,
          "label": "Water goal missed on each of the last 2 days"
        },
        {
          "id": "mass-low",
          "type": "measure",
          "measure": "bodyMass",
          "side": "below",
          "days": 2,
          "label": "Body mass below your baseline for 2 days or more"
        },
        {
          "id": "hr-up",
          "type": "measure",
          "measure": "heartRate",
          "side": "above",
          "days": 1,
          "label": "Resting heart rate above your baseline"
        }
      ],
      "plan": {
        "days": 5,
        "stepsSource": "Adapted from NASA HRP, 'What can be done' for this risk.",
        "steps": [
          {
            "id": "water-goal",
            "type": "auto",
            "rule": "waterGoal",
            "label": "Reach the water goal"
          },
          {
            "id": "meals",
            "type": "manual",
            "label": "Logged all scheduled meals"
          },
          {
            "id": "check-ups",
            "type": "auto",
            "rule": "bothCheckUps",
            "label": "Do both check-ups"
          }
        ]
      }
    },
    {
      "id": "reduced-oxygenation",
      "title": "Reduced oxygenation",
