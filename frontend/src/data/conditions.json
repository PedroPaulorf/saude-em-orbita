        "steps": [
          { "id": "water-goal", "type": "auto", "rule": "waterGoal", "label": "Reach the water goal" },
          { "id": "meals", "type": "manual", "label": "Logged all scheduled meals" },
          { "id": "check-ups", "type": "auto", "rule": "bothCheckUps", "label": "Do both check-ups" }
        ]
      }
    },
