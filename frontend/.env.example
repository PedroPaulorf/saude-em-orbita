# Copie para .env.local e preencha. Este endereço entra no pacote do site: é PÚBLICO.
# Não ponha segredo aqui; a chave do modelo fica só no n8n.
# Use o endereço de PRODUÇÃO do Webhook (fluxo ativo) e libere a origem do site em
# "Allowed Origins (CORS)" nas opções do nó Webhook.
# Fluxos do n8n (pasta "health7"): a regra do app decide o estado; a IA só explica.
# Vazio: o chat roda em modo de demonstração ("Demo reply") e o roteiro é montado no aparelho.
VITE_N8N_CHAT_WEBHOOK_URL=https://n8n.acaizeiros.com.br/webhook/h7-assistente
VITE_N8N_ROADMAP_WEBHOOK_URL=https://n8n.acaizeiros.com.br/webhook/h7-roteiro
# Alerta de ESCALATE: o n8n só registra e confirma (fica com a tripulação). Vazio: registro no aparelho.
VITE_N8N_ALERT_WEBHOOK_URL=https://n8n.acaizeiros.com.br/webhook/h7-alerta

# API autenticada por cookie de sessão. Sem chave compartilhada no navegador.
VITE_API_URL=http://localhost:3001

# Senha PÚBLICA preenchida ao escolher um dos oito perfis fictícios da demo.
# Deve ser igual ao DEMO_PASSWORD do backend. Sem configuração, usa senha123.
VITE_DEMO_PASSWORD=senha123
